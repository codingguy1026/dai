# Dai Gemini server-side trial (never prefix the key with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backup model, only used after repeated HTTP 503
GEMINI_FALLBACK_MODEL=
DAI_ENABLE_GEMINI_API=false

# Extra production opt-in. Login and atomic Supabase request quota are required.
# Inspect API provider billing/limits and talk with a parent before enabling paid usage.
DAI_ENABLE_GEMINI_PRODUCTION=false

# Drawing ID Supabase project (publishable key is public)
NEXT_PUBLIC_SUPABASE_URL=https://nfdwatnoxsoozsiqrwxz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9tXH_OuJ_bGFhowqhadd9A_tQm7z5X8

# Optional central OAuth redirect login
# NEXT_PUBLIC_DRAWING_SSO_ENABLED=true
# DRAWING_SSO_ORIGIN=https://your-dai-site.example
# DRAWING_SSO_CLIENT_ID=<public OAuth client ID registered for Dai>
